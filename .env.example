# Full variable list per SRS §25.2. Phase 0 only wires DATABASE_URL (Prisma).
# Everything else is documented here so later phases don't have to hunt for names.

# --- Database (Phase 0) ---
DATABASE_URL="postgresql://psh:devonly@localhost:5433/psh_petty_cash"
DIRECT_DATABASE_URL="postgresql://psh:devonly@localhost:5433/psh_petty_cash"

# --- Environment (Phase 1) ---
APP_ENV="local"
NEXT_PUBLIC_APP_ENV="local"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# --- Auth (Phase 1) ---
AUTH_SECRET="replace-with-a-generated-local-only-secret"

# --- CORS (Phase 1) ---
CORS_ORIGINS="http://localhost:3000"

# --- Attachments (Phase 4) ---
ATTACHMENT_STORAGE_DRIVER="postgres-bytea"
UPLOAD_MAX_BYTES="2097152"
UPLOAD_RETENTION_DAYS="30"
ARCHIVE_GRACE_DAYS="7"
UPLOAD_ROOT="./var/uploads"

# --- Display / logging ---
TZ_DISPLAY="Asia/Karachi"
LOG_LEVEL="debug"

# --- Rate limiting (Phase 8) ---
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="100"
